# Used only by scripts/apply-approved-suggestions.js, run locally by the
# site owner. Copy this file to .env and fill in the values from the
# Supabase dashboard: Project Settings -> API.
#
# This is the SERVICE ROLE key, not the anon/publishable key — it bypasses
# Row Level Security, so keep .env out of git (already in .gitignore) and
# never put this value in any client-side file like js/bp-supabase.js.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
